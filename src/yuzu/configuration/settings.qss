QListWidget#selectorList { background: #202023; border: none; border-radius: 14px; padding: 8px; outline: none; }
QListWidget#selectorList::item { color: #b9b9c5; padding: 12px 10px; border-radius: 14px; }
QListWidget#selectorList::item:hover { background: #27272e; color: white; }
QListWidget#selectorList::item:selected { background: #383541; color: white; }
QTabWidget::pane { background: #18181b; border: none; border-radius: 0; padding: 10px; }
QTabBar::tab { color: #aaaab8; background: transparent; border: none; border-radius: 14px; padding: 9px 13px; margin: 0 3px 8px 0; }
QTabBar::tab:hover { background: #27272e; color: white; }
QTabBar::tab:selected { background: #383541; color: #eeeef1; }
QGroupBox { color: #dedee6; border: none; border-radius: 0; margin-top: 24px; padding: 14px 8px 8px; }
QGroupBox::title { subcontrol-origin: margin; subcontrol-position: top left; left: 12px; padding: 3px 6px; }
QTabBar::scroller { width: 44px; }
QTabBar QToolButton { padding: 0; border: none; border-radius: 7px; width: 20px; }
QTreeView#ProfileList { background: transparent; border: none; padding: 4px; }
QTreeView#ProfileList::item { padding: 12px; border-radius: 14px; }
QTreeView#ProfileList::item:selected { background: #383541; }
QTreeView#ProfileList::item:hover { background: #29292f; }
QLabel#current_user_username { font-size: 18px; font-weight: 600; }
QListView#udp_server_list { padding: 8px; outline: none; }
QListView#udp_server_list::item { min-height: 28px; padding: 8px 10px; border-radius: 9px; }
QListView#udp_server_list::item:selected { background: #494254; color: #eeeef1; }
QListView#udp_server_list::item:hover { background: #34323d; }

QLabel#SettingsHeading { font-size: 26px; font-weight: 500; color: #f3f2f5; padding: 0; }
QLabel#SettingsSubtitle { color: #aaa8b2; margin-bottom: 14px; }
QFrame[settingsSurface="true"] { background: #252529; border: none; border-radius: 16px; }
QLabel#OverviewValue { font-size: 30px; color: #f3f2f5; }
QWidget#ConfigureInputPlayer QGroupBox { margin-top: 20px; padding: 8px 0 0; }
QWidget#ConfigureInputPlayer QGroupBox QGroupBox { margin-top: 18px; }
