<RCC>
    <qresource prefix="/controller">
        <file alias="matte.png">configuration/assets/controller-matte.png</file>
    </qresource>
    <qresource prefix="/library">
        <file alias="chevron-up.svg">game/icons/chevron-up.svg</file>
        <file alias="controls.qss">util/controls.qss</file>
        <file alias="settings.qss">configuration/settings.qss</file>
        <file alias="network-connected.svg">game/icons/network-connected.svg</file>
        <file alias="network-disconnected.svg">game/icons/network-disconnected.svg</file>
        <file alias="network-connected_notification.svg">game/icons/network-connected_notification.svg</file>

        <file alias="style.qss">game/library.qss</file>
        <file alias="network.qss">multiplayer/network.qss</file>
        <file alias="check.svg">game/icons/check.svg</file>
        <file alias="popups.qss">game/popups.qss</file>
        <file alias="settings.svg">game/icons/settings.svg</file>
        <file alias="refresh.svg">game/icons/refresh.svg</file>
        <file alias="status-bar.qss">game/status_bar.qss</file>
        <file alias="search.svg">game/icons/search.svg</file>
        <file alias="minus.svg">game/icons/minus.svg</file>
        <file alias="plus.svg">game/icons/plus.svg</file>
        <file alias="chevron-down.svg">game/icons/chevron-down.svg</file>
    </qresource>
    <qresource prefix="/img">
        <file alias="dravyn.png">../../dist/dravyn.png</file>
    </qresource>
</RCC>
